{
  "name": "@percentsa/ui",
  "version": "0.1.0",
  "description": "Percent React components (Tailwind v4 + Radix), Saudi kit, bilingual helpers.",
  "license": "MIT",
  "author": "Percent (https://percent.sa)",
  "homepage": "https://design.percent.sa",
  "bugs": "https://github.com/PercentSA/design/issues",
  "keywords": [
    "react",
    "components",
    "radix-ui",
    "tailwindcss",
    "rtl",
    "arabic",
    "saudi",
    "design-system"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PercentSA/design.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "default": "./dist/react-hook-form.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor.d.ts",
      "default": "./dist/code-editor.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/dist-imports.ts dist",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@percentsa/tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-hook-form": "^7.55.0"
  }
}
