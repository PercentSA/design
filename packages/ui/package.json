{
  "name": "@percentsa/ui",
  "version": "0.1.0",
  "description": "Percent React components (Tailwind v4 + Radix), Saudi kit, bilingual helpers.",
  "license": "MIT",
  "author": "Percent (https://percent.sa)",
  "homepage": "https://design.percent.sa",
  "bugs": "https://github.com/PercentSA/design/issues",
  "keywords": [
    "react",
    "components",
    "radix-ui",
    "tailwindcss",
    "rtl",
    "arabic",
    "saudi",
    "design-system"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PercentSA/design.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm --packages external --tsconfig-override tsconfig.build.json && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@percentsa/tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
